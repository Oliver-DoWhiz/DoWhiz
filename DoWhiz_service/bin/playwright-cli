#!/usr/bin/env bash
set -euo pipefail

candidates=(
  "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../skills/playwright/scripts/playwright_cli.sh"
  "${PWD}/DoWhiz_service/skills/playwright/scripts/playwright_cli.sh"
  "${PWD}/.agents/skills/playwright/scripts/playwright_cli.sh"
  "/app/DoWhiz_service/skills/playwright/scripts/playwright_cli.sh"
  "${HOME:-}/.dowhiz/DoWhiz/skills/playwright/scripts/playwright_cli.sh"
)

for script_path in "${candidates[@]}"; do
  if [[ -n "${script_path}" && -f "${script_path}" ]]; then
    exec "${script_path}" "$@"
  fi
done

echo "playwright_cli.sh not found in expected locations" >&2
exit 1
