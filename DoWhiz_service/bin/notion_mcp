#!/usr/bin/env bash
set -euo pipefail

# Check for virtual environment Python first (for externally-managed environments)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_CANDIDATES=(
  "${SCRIPT_DIR}/../.venv/bin/python"
  "${HOME}/server/DoWhiz/DoWhiz_service/.venv/bin/python"
  "/app/DoWhiz_service/.venv/bin/python"
)

PYTHON_BIN=""
for venv_py in "${VENV_CANDIDATES[@]}"; do
  if [[ -x "${venv_py}" ]]; then
    PYTHON_BIN="${venv_py}"
    break
  fi
done

# Fall back to system Python if no venv found
if [[ -z "${PYTHON_BIN}" ]]; then
  if command -v python3 >/dev/null 2>&1; then
    PYTHON_BIN="python3"
  elif command -v python >/dev/null 2>&1; then
    PYTHON_BIN="python"
  else
    echo "python interpreter not found for notion_mcp" >&2
    exit 1
  fi
fi

candidates=(
  "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../skills/notion/scripts/notion_mcp.py"
  "${PWD}/DoWhiz_service/skills/notion/scripts/notion_mcp.py"
  "./.agents/skills/notion/scripts/notion_mcp.py"
  "${PWD}/.agents/skills/notion/scripts/notion_mcp.py"
  "/app/DoWhiz_service/skills/notion/scripts/notion_mcp.py"
  "${HOME:-}/.dowhiz/DoWhiz/skills/notion/scripts/notion_mcp.py"
)

for script_path in "${candidates[@]}"; do
  if [[ -n "${script_path}" && -f "${script_path}" ]]; then
    exec "${PYTHON_BIN}" "${script_path}" "$@"
  fi
done

echo "notion_mcp.py not found in expected locations" >&2
exit 1
